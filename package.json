{
  "name": "tabspace",
  "version": "2.3.0",
  "private": true,
  "description": "Tabspace \u2014 a calm, monochrome workspace, tab, task, notes and focus manager for Chrome.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "icons": "node scripts/build-icons.mjs",
    "theme": "node scripts/build-theme.mjs",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "ical.js": "^2.1.0",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.13.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.17.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/skaskz/tabspace.git"
  },
  "homepage": "https://github.com/skaskz/tabspace",
  "author": "skaskz"
}
